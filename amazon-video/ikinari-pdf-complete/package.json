{
  "name": "ikinari-pdf-complete-video",
  "version": "1.0.0",
  "private": true,
  "description": "いきなりPDF Ver.13 COMPLETE — Amazon 商品動画のレンダリング",
  "scripts": {
    "doctor": "node tools/doctor.js",
    "lint": "node tools/lint-copy.js",
    "config": "node tools/apply-config.js",
    "fonts": "node tools/subset-fonts.js",
    "narration": "python3 tools/narration.py",
